{
  "manifest_version": 3,
  "name": "BHYT Clinical Copilot - Phòng Khám Tài Sanh",
  "version": "1.1.0",
  "description": "In-Browser Copilot hỗ trợ bác sĩ tra cứu danh mục BHYT/YHCT, cảnh báo xuất toán thời gian thực và 1-click clinical note autofill trên phần mềm HIS.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BHYT Clinical Copilot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "data/catalog.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
