{
  "manifest_version": 3,
  "name": "BHYT Clinical Copilot - Phòng Khám Tài Sanh",
  "version": "2.0.1",
  "description": "Trợ lý AI trên trình duyệt & Side Panel cho bác sĩ: Tự động xác định tuyến KCB, cảnh báo xuất toán thời gian thực, Hybrid RAG + Live LLM Q&A và 1-click clinical note autofill cho hệ thống HIS.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mở BHYT Clinical Copilot Side Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "data/catalog.json",
        "test_bed.html",
        "test_bed.js",
        "sidepanel/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
